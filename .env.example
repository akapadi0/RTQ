# Outbound email — Microsoft Graph app-only sendMail, same app registration
# and mailbox as WealthIQ-Money-Assessment-Product ("Money Mindset"). Not
# SMTP/nodemailer — this tenant doesn't have SMTP basic auth enabled.
OUTLOOK_USER=hello@wealthiqco.com
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=

# Advisor address that receives every RTQ report + generated IPS
ADVISOR_EMAIL=aditi@wealthiqco.com

# Microsoft Graph — reused from the Wealth IQ OS meeting-sync app registration
# (delegated Files.ReadWrite already granted, public client — no secret needed).
# A different app registration/flow from CLIENT_ID/CLIENT_SECRET/TENANT_ID
# above, which is app-only and scoped to Mail.Send.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
# One-time seed extracted from the existing local MSAL token cache
# (~/.wiq_token_cache.json). Rotates on every use; the app persists the
# current value to OneDrive as a recovery point (see graph-service.ts).
AZURE_REFRESH_TOKEN_SEED=

# The exact OneDrive item id for "Wealth IQ/COMPLIANCE/Suitability", resolved
# once via graph-service.ts's resolveShareLink() from Aditi's own folder
# share link — avoids guessing at folder paths/names.
SUITABILITY_FOLDER_ID=

# Optional: item id of the "records" subfolder under the Suitability folder
# (each RTQ response is its own JSON file there — see rtq-store.ts). Speeds
# up cold starts by skipping the one-time folder lookup; the app resolves
# and caches it itself if this is left blank.
RECORDS_FOLDER_ID=

PORT=3001
